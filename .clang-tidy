# DAWg static analysis (see docs/CODING_GUIDELINES.md, section 11).
# Pinned tool version: tools/requirements.txt
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  performance-*,
  -performance-enum-size,
  -performance-no-automatic-move,
  modernize-use-nodiscard,
  modernize-use-override,
  modernize-use-nullptr,
  modernize-use-using,
  modernize-use-equals-default,
  modernize-use-equals-delete,
  modernize-make-unique,
  modernize-make-shared,
  modernize-avoid-c-arrays,
  cppcoreguidelines-owning-memory,
  cppcoreguidelines-no-malloc,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-special-member-functions,
  cppcoreguidelines-virtual-class-destructor,
  readability-*,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-braces-around-statements,
  -readability-implicit-bool-conversion,
  -readability-uppercase-literal-suffix,
  -readability-redundant-access-specifiers,
  -readability-convert-member-functions-to-static,
  -readability-avoid-unconditional-preprocessor-if,
  -readability-math-missing-parentheses,
  -readability-qualified-auto

WarningsAsErrors: '*'

# Only report diagnostics in DAWg's own headers.
HeaderFilterRegex: '.*[/\\](engine|app|tests)[/\\].*'
# The clean-room reverb's code (engine/src/loopreverb, tests/loopreverb) has its own .clang-tidy there; its headers
# are only checked from its own files.
ExcludeHeaderFilterRegex: '.*[/\\](src|tests)[/\\]loopreverb[/\\].*'

CheckOptions:
  # Raised from 25 (owner, 2026-11-09): long handler and file-format functions read fine up to here.
  readability-function-cognitive-complexity.Threshold: 40
  readability-function-cognitive-complexity.IgnoreMacros: true
  cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor: true
  cppcoreguidelines-special-member-functions.AllowMissingMoveFunctionsWhenCopyIsDeleted: true
  # The JUCE APIs take ownership of these raw pointers (e.g. juce::var (new DynamicObject())).
  cppcoreguidelines-owning-memory.LegacyResourceConsumers: '::juce::var::var;::juce::DocumentWindow::setContentOwned;::juce::XmlElement::addChildElement'

  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.FunctionCase: camelBack
  readability-identifier-naming.MethodCase: camelBack
  readability-identifier-naming.ParameterCase: camelBack
  readability-identifier-naming.LocalVariableCase: camelBack
  readability-identifier-naming.EnumConstantCase: camelBack
  readability-identifier-naming.ConstexprVariableCase: camelBack
  readability-identifier-naming.ClassConstantCase: camelBack
  readability-identifier-naming.PrivateMemberCase: camelBack
  readability-identifier-naming.PrivateMemberPrefix: m_
  readability-identifier-naming.ProtectedMemberCase: camelBack
  readability-identifier-naming.ProtectedMemberPrefix: m_
  readability-identifier-naming.PublicMemberCase: camelBack
